APP_NAME=AQ Backend
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aq

JWT_SECRET=troque-por-uma-chave-grande-e-aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=720

ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha

# Fica SOMENTE no backend
SPORTS_API_KEY=
SPORTS_API_BASE_URL=https://v3.football.api-sports.io

# Preparado para uso futuro. Fica SOMENTE no backend.
OPENAI_API_KEY=

# Sincronização
# off | loop | cron
SYNC_MODE=off
SYNC_INTERVAL_SECONDS=900
INTERNAL_CRON_TOKEN=troque-por-token-privado

# CORS: separe origens por vírgula. Para Android nativo não é necessário liberar "*".
CORS_ORIGINS=
